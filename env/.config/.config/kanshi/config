profile undocked {
    output eDP-1 enable scale 1
}

output "Vestel Elektronik Sanayi ve Ticaret A. S. 49UHD_LCD_TV Unknown" {
    mode 3840x2160@30
    scale 1
    position 0,0
    alias $GROUPROOM
}

output "Crestron Electronics Inc. Crestron Unknown" {
    mode 1920x1080@60
    scale 1
    position 0,0
    alias $MOVIEROOM
}


profile grouproom_Extend_Left {
    output eDP-1 {
        enable
        mode 2240x1400@60
        scale 1
        position 0,0
    }
    output $GROUPROOM enable position -3840,0
    exec hyprctl keyword monitor DP-1,preferred, auto, 1
    exec swww query | grep eDP-1 | sed -n 's/.*image: //p' | xargs swww img
    }

profile grouproom_Mirror {
    output $GROUPROOM enable
    output eDP-1 enable
    exec hyprctl keyword monitor DP-1,preferred, auto, 1, mirror, eDP-1
}

profile movieroom_Mirror {
    output $MOVIEROOM enable
    output eDP-1 enable
    exec hyprctl keyword monitor DP-1,preferred, auto, 1, mirror, eDP-1
}

profile grouproom_Just_Laptop {
    output $GROUPROOM disable
    output eDP-1
}
