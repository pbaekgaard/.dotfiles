{
  "layer": "bottom",
  "position": "top",
  "output": "eDP-1",
  "reload_style_on_change": true,
  "height": 40,
  "spacing": 2,
  "exclusive": true,
  "gtk-layer-shell": true,
  "passthrough": false,
  "fixed-center": true,
  "modules-left": [
    "hyprland/workspaces",
    "custom/spotify2",
  ],
  "modules-center": ["clock"],
  "modules-right": [
    "backlight",
    "pulseaudio",
    "bluetooth",
    "battery",
    "tray",
    "custom/notification",
    "custom/keyboard_layout",
  ],
  "custom/waybar-scrolling-mpris": {
      "format": "{}",
      "return-type": "json",
      "display-format": "{icon}{artist} - {title}",
      "exec": "~/.config/waybar/scripts/wrapper.sh",
      "icons": {
	  "Paused": "",
	  "Playing": "",
	  "Stopped": "",
      },
      "on-click": "playerctl -p spotify play-pause",
      "length": 35,
  },
  "custom/spotify": {
    "format": "  {}",
    "return-type": "json",
    "on-click": "playerctl -p spotify play-pause",
    "on-click-right": "spotifatius toggle-liked",
    "on-click-middle": "playerctl -p spotify next",
    "exec": "spotifatius monitor",
  },
  "custom/spotify2": {
    "format": "{}",
    "hide-empty-text": true,
    "return-type": "json",
    "on-click": "playerctl -p spotify play-pause",
    "on-click-middle": "hyprctl dispatch workspace 10",
    "on-click-right": "hyprctl dispatch workspace 10",
    "exec": "~/.config/waybar/scripts/wrapper.sh",
    "align": 0,
    "justify": "left",
    "min-length": 30,
  },
  "mpris": {
    "player": "spotify",
    "dynamic-order": ["artist", "title"],
    "format": "{player_icon} {dynamic}",
    "format-paused": "{status_icon}<i>{dynamic}</i>",
    "max-length": 50,
    "status-icons": {
      "paused": " ",
    },
    "player-icons": {
      "default": " ",
    },
  },
  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{id}",
    "all-outputs": true,
    "disable-scroll": false,
    "active-only": false,
    "ignore-workspaces": ["10","11"],
  },
  "hyprland/window": {
    "format": "{title}",
  },
"backlight": {
	"device": "intel_backlight",
	"format": "{icon}\u202F {percent}%",
	"format-icons": ["", "", "", "", "", "", "", "", ""]
},
"tray": {
	"show-passive-items": true,
	"icon-size": 21,
	"spacing": 10,
	"icons": {
	    "blueman": "bluetooth",
	    "Spotify": "Spotify",
	    "TelegramDesktop": "$HOME/.local/share/icons/hicolor/16x16/apps/telegram.png"
	}
},
  "clock#simpleclock": {
    "tooltip": false,
    "format": "{:%H:%M}",
  },
  "clock": {
    "format": "{:L%a %d %b %H:%M}",
    "calendar": {
      "format": {
        "days": "<span weight='normal'>{}</span>",
        "months": "<span color='#cdd6f4'><b>{}</b></span>",
        "today": "<span color='#F54D27' weight='700'><u>{}</u></span>",
        "weekdays": "<span color='#F29718'><b>{}</b></span>",
        "weeks": "<span color='#B8CC52'><b>W{}</b></span>",
      },
      "mode": "month",
      "mode-mon-col": 1,
      "on-scroll": 1,
    },
    "tooltip-format": "<span color='#cdd6f4' font='MonaspiceNe NF 16'><tt><small>{calendar}</small></tt></span>",
  },
  "cpu": {
    "format": "{usage}%",
    "tooltip": true,
    "interval": 1,
  },
"memory": {
    "format": "{used:0.1f}/{total:0.1f}GB",
    "states": {
        "low": 0,
        "medium": 60,
        "high": 90
    }
},
"pulseaudio": {
	"format": "{icon}\u202F {volume}%",
	"format-bluetooth": "{icon}\u202F {volume}%",
	"format-muted": "\u202F",
	"format-icons": {
		"default": ["\u202F", "\u202F"]
	},
	"reverse-scrolling": true,
	"scroll-step": 1,
	"on-click": "hyprctl dispatch exec '[float; size 859 501; move 1370 50] pavucontrol'",
	"on-click-middle": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
	"on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
},
  "custom/sep": {
    "format": "|",
    "tooltip": false,
  },
  "custom/power": {
    "tooltip": false,
    "on-click": "hyprlock",
    "format": "",
  },

  "custom/keyboard_layout": {
    "exec": "~/.config/hypr/scripts/keyboard_util.sh --get",
    "interval": 1,
    "format": "{}",
    "on-click": "$HOME/.config/hypr/scripts/keyboard_util.sh --toggle",
    "tooltip": false
  },
  "custom/notification": {
    "escape": true,
    "exec": "swaync-client -swb",
    "exec-if": "which swaync-client",
    "format": "{icon}",
    "format-icons": {
      "none": "󰅺",
      "notification": "󰡟",
    },
    "on-click": "sleep 0.1 && swaync-client -t -sw",
    "return-type": "json",
    "tooltip": false,
  },
"battery": {
        "format": "{icon}\u202F {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "format-time": "{H}h{M}m",
        "format-charging": "\u202F {capacity}%",
        "format-full": "{capacity}%",
        "interval": 2,
        "states": {
            "warning": 20,
            "critical": 10
        },
        "tooltip": false,
        "on-click": "2"
    },
"network": {
	"format": "{ifname}",
	"format-wifi": "\u202F",
	"format-ethernet": "\u202F",
	"format-disconnected": "\u202F",
	"format-disabled": "\u202F",
	"tooltip-format": "{ifname}",
	"tooltip-format-wifi": "{essid} ({signalStrength}%) \u202F",
	"tooltip-format-ethernet": "{ifname} \u202F",
	"tooltip-format-disconnected": "Disconnected",
	"tooltip-format-disabled": "Disabled",
	"on-click": "$HOME/.config/rofi/scripts/network.sh",
	"max-length": 50
},
"bluetooth": {
	"format": "",
	"format-connected": " {device_alias}",
	"format-connected-battery": " {device_alias} {device_battery_percentage}%",
	// "format-device-preference": [ "device1", "device2" ], // preference list deciding the displayed device
	"tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
	"tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
	"tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
	"tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
	"on-click": "hyprctl dispatch exec '[float; size 529 512; move 1620 50] blueman-manager'"
}
}
