#!/usr/bin/env zsh

# Ensure tmuxifier is loaded
# source ~/.zshrc

if (( $# == 1 )); then
    selected=$1
else
    selected=$(tmuxifier list-sessions | fzf --print-query)
fi
res=$(echo $selected | wc -l)

if [ "$res" = 2 ]; then
    selection=$(echo "$selected" | sed -n '2p')
    tmuxifier load-session "$selection"
else
    tmuxifier new-session "$selected"
fi

#

