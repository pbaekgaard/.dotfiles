// vim: fdm=marker

configuration {
  modes: "window,drun,run,ssh";
  font: "JetBrainsMono NF 18";
  drun-display-format: "{name}";
}

* {
  // general
  bgt: #0d101755;
  t: transparent;
//  fg: #dddfe3;
  bg: #f1873e;
  fg: #131721;
  text-alt-color: #bfbdb6;
  font:                        "JetBrains Mono Nerd Font 18";

  selected-bg: #0f1419;
  selected-fg: #e5841c;

  // for windows
  active: #a9b665;
  urgent: #fb4934;
}

window {
  fullscreen: true;
  padding: 35% 30%;       // you might want to ajust these to resize rofi.
  transparency: "real";
  background-color: @bgt;
  border-color: @t;
}

listview {
  border: 0 0 0 0;
  padding: 23 0 0;
  scrollbar: true;
}

scrollbar {
    enabled: false;
    width:        0px;
    border:       0;
    handle-color: @fg;
    handle-width: 0px;
    padding:      0 5;
}

entry {
    enabled:                     true;
    background-color:            inherit;
    text-color:                  inherit;
    cursor:                      none;
    placeholder:                 "Search";
    placeholder-color:           inherit;
}

// less interesting stuff {{{

// using elements from:
// https://github.com/bardisty/gruvbox-rofi/blob/master/gruvbox-common.rasi

textbox {
    text-color: @fg;
}

element {
    border:  0;
    padding: 2px;
}
element.normal.normal {
    background-color: @t;
    text-color:       @text-alt-color;
}
element.normal.urgent {
    background-color: @t;
    text-color:       @urgent;
}
element.normal.active {
    background-color: @t;
    text-color:       @active;
}
element.selected.normal {
    background-color: @selected-bg;
    text-color:       @selected-fg;
}
element.selected.urgent {
    background-color: @selected-bg;
    text-color:       @urgent;
}
element.selected.active {
    background-color: @selected-bg;
    text-color:       @selected-fg;
}
element.alternate.normal {
    background-color: @t;
    text-color:       @text-alt-color;
}
element.alternate.urgent {
    background-color: @t;
    text-color:       @urgent;
}
element.alternate.active {
    background-color: @t;
    text-color:       @active;
}

sidebar {
    border:       2px 0 0;
    border-color: @fg;
}

inputbar {
    enabled:                     true;
    spacing:                     10px;
    padding:                     15px;
    border-radius:               10px;
    children:                    [ "textbox-prompt-colon", "entry" ];
}
textbox-prompt-colon {
    text-color:                  @text-alt-color;
    enabled:                     true;
    expand:                      false;
    str:                         "";
}
entry {
    enabled:                     true;
    cursor:                      text;
    placeholder:                 @prompt;
    text-color: @text-alt-color;
}

case-indicator,
button {
    spacing:    0;
    text-color: @fg;
}

button.selected {
    background-color: @bg;
    text-color:       @fg;
}

prompt {
    expand:                      false;
    str:                         "";
    background-color:            inherit;
    text-color:                  inherit;
}

textbox-prompt-sep {
    expand:     false;
    str:        ":";
    text-color: @fg;
    margin:     0 0.3em 0 0;
}
// }}}
